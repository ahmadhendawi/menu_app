<% content_for :title, "Cart" %>
<section class="mx-auto max-w-3xl">
  <div class="mb-6">
    <h1 class="text-3xl font-bold">Your cart</h1>
    <p class="mt-1 text-slate-600">Review your items before checkout.</p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <% if @cart_items.any? %>
      <ul class="divide-y divide-slate-200">
        <% @cart_items.each do |item| %>
          <li class="flex items-center justify-between gap-4 py-4 first:pt-0">
            <div>
              <p class="font-semibold"><%= item.name %></p>
              <p class="mt-1 text-sm text-slate-500"><%= item.description %></p>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-semibold">$<%= item.price %></span>
              <%= button_to "Remove", remove_from_cart_path(item), method: :delete, class: "cursor-pointer text-sm font-medium text-red-600 hover:underline" %>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-6">
        <span class="text-slate-600">Order total</span>
        <span class="text-2xl font-bold">$<%= @cart_items.sum(&:price) %></span>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to "Continue browsing", root_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-center font-semibold hover:bg-slate-100" %>
        <%= link_to "Continue to checkout", new_order_path, class: "rounded-lg bg-emerald-600 px-4 py-2 text-center font-semibold text-white hover:bg-emerald-700" %>
      </div>
    <% else %>
      <div class="py-10 text-center">
        <h2 class="mt-4 text-xl font-semibold">Your cart is empty</h2>
        <p class="mt-2 text-slate-500">Choose a restaurant and add something delicious.</p>
        <%= link_to "Browse restaurants", root_path, class: "mt-6 inline-block rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
      </div>
    <% end %>
  </div>
</section>
