<% content_for :title, "Receipt"%>
<section class="mx-auto max-w-lg">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-700">✓</div>
      <h1 class="mt-4 text-3xl font-bold">Order received</h1>
      <p class="mt-2 text-slate-600">Thanks, <%= @order.customer_name %>. The restaurant has your order.</p>
    </div>

    <div class="mt-8 rounded-lg bg-slate-50 p-4">
      <div class="flex justify-between gap-4 text-sm">
        <span class="text-slate-500">Phone</span>
        <span class="font-medium"><%= @order.phone %></span>
      </div>
      <div class="mt-3 flex justify-between gap-4 text-sm">
        <span class="text-slate-500">Status</span>
        <span class="rounded-full bg-amber-100 px-3 py-1 font-medium text-amber-800"><%= @order.status.capitalize %></span>
      </div>
    </div>

    <h2 class="mt-8 font-semibold">Order items</h2>
    <ul class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
      <% @order.order_items.each do |item| %>
        <li class="flex justify-between gap-4 py-3 text-sm">
          <span><%= item.menu_item.name %></span>
          <span class="font-semibold">$<%= item.menu_item.price %></span>
        </li>
      <% end %>
    </ul>

    <%= link_to "Back to restaurants", root_path, class: "mt-7 block rounded-lg bg-emerald-600 px-4 py-2 text-center font-semibold text-white hover:bg-emerald-700" %>
  </div>
</section>
