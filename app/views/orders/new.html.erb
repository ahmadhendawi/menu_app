<% content_for :title, "Checkout"%>
<section class="mx-auto max-w-lg">
  <%= link_to "← Back to cart", cart_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
  <div class="mt-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-3xl font-bold">Checkout</h1>
    <p class="mb-7 mt-2 text-slate-600">Tell the restaurant who this order is for.</p>

    <%= form_with model: @order, url: orders_path, local: true, class: "space-y-5" do |f| %>
      <% if @order.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
          <ul class="list-disc pl-5">
            <% @order.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :customer_name, "Your name", class: "block text-sm font-medium" %>
        <%= f.text_field :customer_name, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :phone, "Phone number", class: "block text-sm font-medium" %>
        <%= f.telephone_field :phone, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      </div>
      <%= f.submit "Place order", class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-4 py-3 font-semibold text-white hover:bg-emerald-700" %>
    <% end %>
  </div>
</section>
