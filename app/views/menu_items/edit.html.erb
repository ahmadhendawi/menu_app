<% content_for :title, "Editing menu item" %>

<section class="mx-auto max-w-2xl">
  <%= link_to "← Back to dashboard", admin_dashboard_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
  <div class="mt-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-3xl font-bold">Edit menu item</h1>
    <p class="mb-7 mt-2 text-slate-600">Update how this item appears to customers.</p>
    <%= render "form", menu_item: @menu_item %>
  </div>
</section>
