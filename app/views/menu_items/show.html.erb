<% content_for :title, "Showing menu item" %>

<section class="mx-auto max-w-xl">
  <%= link_to "← Back to dashboard", admin_dashboard_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
  <div class="mt-4">
    <%= render @menu_item %>
  </div>
  <div class="mt-5 flex flex-wrap gap-3">
    <%= link_to "Edit item", edit_menu_item_path(@menu_item), class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
    <%= button_to "Delete item", @menu_item, method: :delete, class: "rounded-lg border border-red-200 px-4 py-2 font-semibold text-red-700 hover:bg-red-50", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</section>
