<%= form_with(model: menu_item, class: "space-y-5") do |form| %>
  <% if menu_item.errors.any? %>
    <div id="error_explanation" class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-semibold"><%= pluralize(menu_item.errors.count, "error") %> prevented this item from being saved:</h2>

      <ul class="mt-2 list-disc pl-5 text-sm">
        <% menu_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium" %>
    <%= form.text_field :name, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
    <% if menu_item.errors[:name].any? %>
      <p class="mt-1 text-sm text-red-600"><%= menu_item.errors[:name].first %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium" %>
    <%= form.textarea :description, rows: 4, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
    <% if menu_item.errors[:description].any? %>
      <p class="mt-1 text-sm text-red-600"><%= menu_item.errors[:description].first %></p>
    <% end %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :price, class: "block text-sm font-medium" %>
      <%= form.number_field :price, step: 0.01, min: 0, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      <% if menu_item.errors[:price].any? %>
        <p class="mt-1 text-sm text-red-600"><%= menu_item.errors[:price].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :position, class: "block text-sm font-medium" %>
      <%= form.number_field :position, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      <% if menu_item.errors[:position].any? %>
        <p class="mt-1 text-sm text-red-600"><%= menu_item.errors[:position].first %></p>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.label :images, class: "block text-sm font-medium" %>
    <%= form.file_field :images, multiple: true, accept: "image/png,image/jpeg,image/jpg,image/gif", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
    <% if menu_item.errors[:images].any? %>
      <p class="mt-1 text-sm text-red-600"><%= menu_item.errors[:images].first %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-3 rounded-lg bg-slate-50 p-4">
    <%= form.checkbox :active, class: "h-5 w-5 rounded border-slate-300 text-emerald-600" %>
    <div>
      <%= form.label :active, "Show this item on the public menu", class: "font-medium" %>
      <p class="text-sm text-slate-500">Inactive items remain saved but customers cannot see them.</p>
    </div>
    <% if menu_item.errors[:active].any? %>
      <p class="text-sm text-red-600"><%= menu_item.errors[:active].first %></p>
    <% end %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700 sm:w-auto" %>
  </div>
<% end %>
