<% content_for :title, "Restaurant Login" %>
<section class="mx-auto max-w-md">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="mb-7 text-center">
      <h1 class="text-3xl font-bold">Restaurant login</h1>
      <p class="mt-2 text-slate-600">Manage your menu and restaurant details.</p>
    </div>

    <%= form_with url: login_path, local: true, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium" %>
        <%= f.email_field :email, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none", required: true %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium" %>
        <%= f.password_field :password, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none", required: true %>
      </div>

      <%= f.submit "Log in", class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      Need an account? <%= link_to "Create your restaurant", signup_path, class: "font-semibold text-emerald-700 hover:underline" %>
    </p>
  </div>
</section>
