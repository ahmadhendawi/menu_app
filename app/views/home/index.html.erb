<% content_for :title, "Restaurants" %>
<section class="mb-12 text-center">
  <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-emerald-700">Local menus, simple ordering</p>
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">What are you hungry for?</h1>
  <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">Choose a restaurant, explore its menu, and place your order in a few easy steps.</p>
</section>

<section>
  <div class="mb-6 flex items-end justify-between">
    <div>
      <h2 class="text-2xl font-bold">Restaurants</h2>
      <p class="mt-1 text-slate-600">Browse the restaurants available today.</p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% Restaurant.all.uniq(&:slug).each do |restaurant| %>
      <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-xl font-bold text-emerald-700">
          <%= restaurant.name.first.upcase %>
        </div>
        <h3 class="text-xl font-semibold"><%= restaurant.name %></h3>
        <p class="mt-2 text-sm text-slate-500">Freshly prepared items from this restaurant.</p>
        <%= link_to "View menu", menu_path(restaurant.slug), class: "mt-5 inline-block rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
      </article>
    <% end %>
  </div>
</section>

<section class="mt-12 rounded-xl bg-slate-900 px-6 py-8 text-center text-white sm:px-10">
  <h2 class="text-2xl font-bold">Own a restaurant?</h2>
  <p class="mt-2 text-slate-300">Create and manage your menu from one simple dashboard.</p>
  <div class="mt-5 flex flex-wrap justify-center gap-3">
    <%= link_to "Log in", login_path, class: "rounded-lg bg-white px-4 py-2 font-semibold text-slate-900 hover:bg-slate-100" %>
    <%= link_to "Create an account", signup_path, class: "rounded-lg border border-slate-600 px-4 py-2 font-semibold hover:bg-slate-800" %>
  </div>
</section>
