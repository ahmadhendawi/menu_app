<% content_for :title, "Restaurant Sign Up" %>

<section class="mx-auto max-w-md">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="mb-7 text-center">
      <h1 class="text-3xl font-bold">Create your restaurant</h1>
      <p class="mt-2 text-slate-600">Set up an account and start building your menu.</p>
    </div>

    <%= form_with model: @restaurant, url: signup_path, local: true, class: "space-y-5" do |f| %>
      <% if @restaurant.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
          <p class="font-semibold">Please fix the following:</p>
          <ul class="mt-2 list-disc pl-5">
            <% @restaurant.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-medium" %>
        <%= f.text_field :name, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :slug, "Menu URL name", class: "block text-sm font-medium" %>
        <%= f.text_field :slug, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
        <p class="mt-1 text-xs text-slate-500">Example: burger-palace</p>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium" %>
        <%= f.email_field :email, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium" %>
        <%= f.password_field :password, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-medium" %>
        <%= f.password_field :password_confirmation, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-600 focus:outline-none" %>
      </div>

      <%= f.submit "Create account", class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      Already registered? <%= link_to "Log in", login_path, class: "font-semibold text-emerald-700 hover:underline" %>
    </p>
  </div>
</section>
