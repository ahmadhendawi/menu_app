<% content_for :title, "#{@restaurant.name} Menu" %>

<section>
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= link_to "← All restaurants", root_path, class: "text-sm font-medium text-emerald-700 hover:underline" %>
      <h1 class="mt-3 text-3xl font-bold"><%= @restaurant.name %></h1>
      <p class="mt-1 text-slate-600">Choose an item to add to your cart.</p>
    </div>
    <%= link_to "View cart", cart_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-center font-semibold hover:bg-slate-100" %>
  </div>

  <% cache ["public-menu", @restaurant] do %>
      <% if @menu_items.any? %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @menu_items.each do |menu_item| %>
        <%= render partial: "menu_items/menu_item", locals: { menu_item: menu_item } %>
      <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <h2 class="text-lg font-semibold">No menu items yet</h2>
        <p class="mt-1 text-slate-500">This restaurant is still preparing its menu.</p>
      </div>
    <% end %>
  <% end %>
</section>
